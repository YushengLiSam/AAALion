# Copy to deploy/milvus/.env (gitignored), then: chmod 600 .env
# Used by docker compose (variable interpolation) and tools/milvus_bootstrap.py --env-file.
# 12–72 bytes each, all different. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(24))"

# root account. Applied when Milvus first initialises /srv/milvus; bootstrap rotates it otherwise.
MILVUS_ROOT_PASSWORD=
# Only if root was initialised with something other than the factory default "Milvus".
# MILVUS_OLD_ROOT_PASSWORD=

# Created by tools/milvus_bootstrap.py
LIONPICK_MILVUS_APP_PASSWORD=
LIONPICK_MILVUS_ADMIN_PASSWORD=

# Storage: local (default, no MinIO) | minio (also run: docker compose --profile minio up -d)
MILVUS_STORAGE_TYPE=local
# Only for the minio profile. docker.io/minio/minio is no longer pullable (2026-10-06):
# pin an image you have vetted, by digest, e.g. MINIO_IMAGE=registry.example/minio@sha256:...
# MINIO_IMAGE=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
